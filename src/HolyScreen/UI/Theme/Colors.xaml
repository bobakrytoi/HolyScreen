<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ============================ Palette ============================ -->
    <!-- Dark, neutral graphite surfaces with restrained cool-white accent. -->
    <Color x:Key="SurfaceColor">#15171B</Color>
    <Color x:Key="SurfaceColorRaised">#202329</Color>
    <Color x:Key="SurfaceColorOverlay">#1A1D22</Color>
    <Color x:Key="SurfaceColorInput">#0F1115</Color>
    <Color x:Key="PrimaryTextColor">#F5F6F8</Color>
    <Color x:Key="SecondaryTextColor">#A2A7B0</Color>
    <Color x:Key="TertiaryTextColor">#6E737C</Color>
    <Color x:Key="AccentColor">#C7D2E3</Color>
    <Color x:Key="AccentColorStrong">#DCE4F0</Color>
    <Color x:Key="AccentMutedColor">#5A6475</Color>
    <Color x:Key="DangerColor">#E5796F</Color>
    <Color x:Key="SuccessColor">#8FD39A</Color>

    <!-- ============================ Brushes ============================ -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceColorRaised}" />
    <SolidColorBrush x:Key="SurfaceOverlayBrush" Color="{StaticResource SurfaceColorOverlay}" />
    <SolidColorBrush x:Key="InputBrush" Color="{StaticResource SurfaceColorInput}" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="TertiaryTextBrush" Color="{StaticResource TertiaryTextColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentStrongBrush" Color="{StaticResource AccentColorStrong}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />

    <!-- Thin, understated borders: white at low opacity. -->
    <SolidColorBrush x:Key="BorderBrush" Color="#FFFFFF" Opacity="0.08" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#FFFFFF" Opacity="0.14" />
    <SolidColorBrush x:Key="BorderFocusBrush" Color="{StaticResource AccentColor}" Opacity="0.55" />

    <!-- Hover / pressed washes. -->
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#FFFFFF" Opacity="0.06" />
    <SolidColorBrush x:Key="PressedOverlayBrush" Color="#FFFFFF" Opacity="0.10" />
    <SolidColorBrush x:Key="SelectedOverlayBrush" Color="#FFFFFF" Opacity="0.12" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="{StaticResource DangerColor}" Opacity="0.16" />

    <!-- ============================ Typography ============================ -->
    <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFontFamily">Segoe UI Variable Display, Segoe UI Semibold, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Cascadia Mono, Consolas, Courier New</FontFamily>

    <sys:Double x:Key="FontSizeCaption">11.5</sys:Double>
    <sys:Double x:Key="FontSizeBody">13</sys:Double>
    <sys:Double x:Key="FontSizeSubtitle">15</sys:Double>
    <sys:Double x:Key="FontSizeTitle">19</sys:Double>
    <sys:Double x:Key="FontSizeDisplay">26</sys:Double>

    <!-- ============================ Metrics ============================ -->
    <CornerRadius x:Key="RadiusSmall">6</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">10</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">14</CornerRadius>
    <Thickness x:Key="FieldPadding">12,9</Thickness>

</ResourceDictionary>
