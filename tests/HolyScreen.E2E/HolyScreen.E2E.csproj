<Project Sdk="Microsoft.NET.Sdk">

  <!--
    End-to-end runner: launches the real HolyScreen.exe with an isolated data directory, drives it with injected
    keyboard/mouse input and verifies the results (files, windows, clipboard, pixels). It runs on the live desktop.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <IsPackable>false</IsPackable>
    <RootNamespace>HolyScreen.E2E</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HolyScreen\HolyScreen.csproj" />
  </ItemGroup>

</Project>
